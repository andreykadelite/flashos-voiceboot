# Public source allowlist. Downloads, binaries, USB backups and local reports
# remain on the development machine and never enter Git history.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/LICENSE
!/NOTICE.md
!/THIRD-PARTY.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CITATION.cff
!/.github/
!/src/
/src/*
!/src/*.py
!/installer/
/installer/*
!/installer/*.py
!/installer/*.ps1
!/installer/requirements-build.txt
!/boot/
!/tests/
/tests/*
!/tests/*.py
!/docs/
/docs/*
!/docs/ru/
!/docs/en/
!/docs/images/
!/metadata/
!/licenses/
!/build/
/build/*
!/build/setup-builder.sh
!/build/build-system.sh
!/build/install-admin.sh
!/build/install-recovery.sh
!/build/install-rhvoice.py
!/build/install-sof.py
!/build/repack-system.sh
!/tools/
/tools/*
!/tools/Build-Installer.ps1
!/tools/build-installer-payload.py
!/tools/fetch-build-inputs.py
!/tools/collect-debian-sources.py
!/tools/sanitize-live-root.py
!/tools/package-public-docs.py
!/tools/export-system.py
!/tools/check-publication.py
!/tools/check-installer-qt.py
!/tools/check-installer-manifest.py
!/tools/prepare-boot.py
!/tools/make-test-disk.py
!/tools/make-toolkit-fixture.py
!/tools/vm.py
!/tools/test-media.py
!/tools/verify-runtime.py
!/tools/verify-toolkit-build.py
!/tools/verify-product.py
!/tools/verify-recovery.py
!/tools/check-graphical.py
!/tools/check-photorec-deleted.py
!/tools/audio-evidence.py
!/tools/audit-manifest.py
!/tools/write-help.py
!/tools/public_payload.py
!/tools/public-files.json
__pycache__/
*.pyc
*.log
